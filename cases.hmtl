<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Cases</title>

<style>
body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #eef1f5;
    color: #1a1a1a;
}

.header {
    background: #0d2a4a;
    color: white;
    text-align: center;
    padding: 20px;
}

.header h1 {
    margin: 0;
    font-size: 24px;
}

.header p {
    margin: 5px 0;
    font-size: 13px;
}

.nav {
    background: #123a66;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
}

.nav a {
    color: white;
    padding: 12px 18px;
    text-decoration: none;
    font-weight: bold;
    font-size: 14px;
}

.nav a:hover {
    background: #0b2542;
}

.container {
    max-width: 1100px;
    margin: 20px auto;
    padding: 10px;
}

.section {
    background: white;
    margin-bottom: 20px;
    border-radius: 5px;
    overflow: hidden;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

.section-header {
    background: #0d2a4a;
    color: white;
    padding: 12px 15px;
    font-size: 17px;
    font-weight: bold;
}

.section-content {
    padding: 15px;
}

.info-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
}

.info-block {
    flex: 1;
    min-width: 250px;
}

.info-line {
    margin: 6px 0;
}

.badge {
    display: inline-block;
    padding: 6px 10px;
    background: #0d2a4a;
    color: white;
    font-size: 12px;
    border-radius: 3px;
    margin-top: 5px;
}

.cost-box {
    background: #f7f9fc;
    border-left: 5px solid #0d2a4a;
    padding: 12px;
    margin-bottom: 10px;
}

.notice {
    background: #f0f2f5;
    padding: 12px;
    font-size: 13px;
    border-left: 4px solid #999;
    margin-top: 10px;
}

.footer {
    text-align: center;
    padding: 15px;
    background: #0d2a4a;
    color: white;
    font-size: 12px;
}
</style>
</head>

<body>

<div class="header">
    <h1>Oklahoma County Detention Center©</h1>
    <p>Pretrial Services Division</p>
    <p>201 N. Shartel Ave, Oklahoma City, OK 73102</p>
</div>

<div class="nav">
    <a href="index.html">Home</a>
    <a href="programs.html">Programs</a>
    <a href="case.html">Cases</a>
    <a href="transport.html">Transports</a>
    <a href="payments.html">Payments</a>
    <a href="contact.html">Contacts</a>
    <a href="agreements.html">Agreements</a>
</div>

<div class="container">

    <!-- PAGE TITLE -->
    <div class="section">
        <div class="section-header">Cases</div>
        <div class="section-content">
            <p>Pretrial Applicant Eligibility & Financial Obligations Profile (PAEFOR)</p>
        </div>
    </div>

    <!-- APPLICANT IDENTIFICATION -->
    <div class="section">
        <div class="section-header">Applicant Identification</div>
        <div class="section-content info-grid">

            <div class="info-block">
                <div class="info-line"><strong>Full Name:</strong> John A. Doe</div>
                <div class="info-line"><strong>Date of Birth:</strong> 01/01/1990</div>
                <div class="info-line"><strong>Booking ID:</strong> OKC-458221</div>
            </div>

            <div class="info-block">
                <div class="info-line"><strong>Case Number:</strong> CF-2026-1022</div>
                <div class="info-line"><strong>Status:</strong> Pretrial Hold</div>
                <div class="badge">Eligibility Review Pending</div>
            </div>

        </div>
    </div>

    <!-- CHARGES -->
    <div class="section">
        <div class="section-header">Charges</div>
        <div class="section-content">
            <div class="info-line">• Possession of Controlled Substance</div>
            <div class="info-line">• Driving Under the Influence</div>
        </div>
    </div>

    <!-- PROGRAM ELIGIBILITY -->
    <div class="section">
        <div class="section-header">Program Eligibility</div>
        <div class="section-content">

            <div class="cost-box">
                Recommended: PASS®™ Program (Outpatient)
            </div>

            <div class="cost-box">
                Secondary: SOBER-STEP®™ Program
            </div>

        </div>
    </div>

    <!-- FINANCIAL OBLIGATIONS -->
    <div class="section">
        <div class="section-header">Financial Obligations</div>
        <div class="section-content">

            <div class="cost-box">PASS®™: $2,028.00</div>
            <div class="cost-box">SOBER-STEP®™: $845.00</div>
            <div class="cost-box">Processing Fee: $150.00</div>

            <div class="cost-box">
                <strong>Total Estimated Obligation: $3,023.00</strong>
            </div>

        </div>
    </div>

    <!-- REQUIREMENTS -->
    <div class="section">
        <div class="section-header">Requirements</div>
        <div class="section-content">
            <div class="info-line">• Weekly check-ins</div>
            <div class="info-line">• Random drug testing</div>
            <div class="info-line">• Program compliance required</div>
            <div class="info-line">• Mandatory court appearance</div>
        </div>
    </div>

    <!-- NOTICE -->
    <div class="section">
        <div class="section-header">Official Notice</div>
        <div class="section-content">
            <div class="notice">
                This PAEFOR Profile is an informational summary of eligibility, financial obligations, and program requirements. Final determinations are made by the assigned pretrial officer and court authority.
            </div>
        </div>
    </div>

</div>

<div class="footer">
    © 2026 Oklahoma County Pretrial Services | Official Use Only
</div>

</body>
</html>
